# Reverse proxy with active-passive failover
# Primary: slave host open-webui via TLS (fast, local GPU)
# Fallback: local open-webui via TLS internal (same container, localhost avoids IP SAN issue)
#
# cloudflared tunnel points to http://caddy:8080
# SLAVE_OPEN_WEBUI_URL must be set in .env (e.g. <slave-ip>:3443)

# Local TLS endpoint for fallback — using localhost so Caddy internal CA can issue a cert
:3444 {
	tls internal
	reverse_proxy open-webui:8080
}

:8080 {
	log {
		output stderr
	}

	reverse_proxy {
		to https://{$SLAVE_OPEN_WEBUI_URL} https://localhost:3444

		transport http {
			tls_insecure_skip_verify
		}

		lb_policy first

		health_uri /health
		health_interval 5s
		health_timeout 3s

		header_down X-Upstream {http.reverse_proxy.upstream.address}
	}
}
