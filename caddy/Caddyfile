# Reverse proxy with active-passive failover
# Primary: slave host open-webui (fast, local GPU)
# Fallback: local open-webui (same compose network)
#
# cloudflared tunnel points to http://caddy:8080
# SLAVE_OPEN_WEBUI_URL must be set in .env (e.g. <slave-ip>:3000)

:8080 {
	log {
		output stderr
		format console
	}

	reverse_proxy {
		to {$SLAVE_OPEN_WEBUI_URL} open-webui:8080

		lb_policy first

		health_uri /health
		health_interval 5s
		health_timeout 3s
	}
}
