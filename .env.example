# =============================================================================
# Open WebUI Stack - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# =============================================================================

# ---------------------------------------------------------------------------
# Compose Profiles (host-specific service activation)
# ---------------------------------------------------------------------------
# Master host (runs postgres, caddy, cloudflared):
#   COMPOSE_PROFILES=db-host,gateway
# Slave host (no local DB or gateway):
#   (leave unset)

# ---------------------------------------------------------------------------
# LLM Backend
# ---------------------------------------------------------------------------
# For litellm-proxy + llama-swap direct (bypass):
#   OPENAI_API_BASE_URLS=http://litellm-proxy:4000/v1;<llama-swap-url>/v1
#   OPENAI_API_KEYS=<your-litellm-master-key>;not-needed
# Semicolon-separated; API key count must match endpoint count.
#
OPENAI_API_BASE_URLS=http://litellm-proxy:4000/v1
OPENAI_API_KEYS=<your-litellm-master-key>

# ---------------------------------------------------------------------------
# Data / Certificate Paths (absolute paths on host)
# ---------------------------------------------------------------------------
# Open WebUI data directory (webui.db, uploads/, etc.)
OPEN_WEBUI_DATA_DIR=/path/to/open-webui-data

# CA certificate generated by mkcert etc. (required if LLM server uses self-signed cert)
CA_CERT_PATH=/path/to/rootCA.pem

# ---------------------------------------------------------------------------
# Ports (optional, defaults shown)
# ---------------------------------------------------------------------------
# OPEN_WEBUI_PORT=3000
# SEARXNG_PORT=8888

# ---------------------------------------------------------------------------
# SearXNG
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=your-searxng-secret-here

# ---------------------------------------------------------------------------
# PostgreSQL (required for multi-host deployment)
# ---------------------------------------------------------------------------
POSTGRES_USER=openwebui
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me
POSTGRES_DATA_DIR=/path/to/postgres-data
# POSTGRES_PORT=5432

# Database URL for Open WebUI (omit or leave empty for SQLite default)
# Uses OPEN_WEBUI_DATABASE_URL to avoid conflict with LiteLLM's DATABASE_URL.
# Master host (postgres in same compose):
#   OPEN_WEBUI_DATABASE_URL=postgresql://openwebui:<password>@postgres:5432/openwebui
# Slave host (postgres on master host over LAN):
#   OPEN_WEBUI_DATABASE_URL=postgresql://openwebui:<password>@<db-host-ip>:5432/openwebui
OPEN_WEBUI_DATABASE_URL=

# ---------------------------------------------------------------------------
# Caddy - Failover reverse proxy (master host only)
# ---------------------------------------------------------------------------
# Primary upstream (slave host Open WebUI):
# SLAVE_OPEN_WEBUI_URL=<slave-ip>:3000

# ---------------------------------------------------------------------------
# Cloudflare Tunnel
# ---------------------------------------------------------------------------
# Obtain from: Cloudflare Zero Trust Dashboard > Networks > Tunnels > Configure
# After adding caddy, update the tunnel origin URL in Cloudflare dashboard:
#   Old: http://open-webui:8080   New: http://caddy:8080
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ---------------------------------------------------------------------------
# LiteLLM Proxy
# ---------------------------------------------------------------------------
# Generate with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-change-me
LITELLM_PORT=4000

# Local LLM endpoints (must include /v1)
# Example: https://<gpu-host>:8443/v1
LLAMA_SERVER_URL=
# Portable host (leave empty if not available)
PORTABLE_LLM_SERVER_URL=

# Local model names (must match llama-swap model keys)
# Prefix with "openai/" for LiteLLM's OpenAI-compatible routing
REASONER_LOCAL_MODEL=openai/gpt-oss-20b-MXFP4
JUDGE_LOCAL_MODEL=openai/Qwen2.5-7B-Instruct-Q4_K_M

# Cloud fallback models
REASONER_CLOUD_MODEL=openai/gpt-4o
JUDGE_CLOUD_MODEL=openai/gpt-4o-mini

# Cloud API key (optional, for fallback)
CLOUD_API_KEY=
