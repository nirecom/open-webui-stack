# =============================================================================
# Open WebUI Stack - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Backend
# ---------------------------------------------------------------------------
# Two endpoints: litellm-proxy for routed models + llama-swap direct for bypass.
# Semicolon-separated; API key count must match endpoint count.
#
# For litellm-proxy only (no bypass):
#   OPENAI_API_BASE_URLS=http://litellm-proxy:4000/v1
#   OPENAI_API_KEYS=<your-litellm-master-key>
#
OPENAI_API_BASE_URLS=http://litellm-proxy:4000/v1;${LLAMA_SERVER_URL}
OPENAI_API_KEYS=${LITELLM_MASTER_KEY};not-needed

# ---------------------------------------------------------------------------
# Data / Certificate Paths (absolute paths on host)
# ---------------------------------------------------------------------------
# Open WebUI data directory (webui.db, uploads/, etc.)
OPEN_WEBUI_DATA_DIR=/path/to/open-webui-data

# CA certificate generated by mkcert etc. (required if LLM server uses self-signed cert)
CA_CERT_PATH=/path/to/rootCA.pem

# ---------------------------------------------------------------------------
# Ports (optional, defaults shown)
# ---------------------------------------------------------------------------
# OPEN_WEBUI_PORT=3000
# SEARXNG_PORT=8888

# ---------------------------------------------------------------------------
# SearXNG
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=your-searxng-secret-here

# ---------------------------------------------------------------------------
# Cloudflare Tunnel
# ---------------------------------------------------------------------------
# Obtain from: Cloudflare Zero Trust Dashboard > Networks > Tunnels > Configure
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ---------------------------------------------------------------------------
# LiteLLM Proxy
# ---------------------------------------------------------------------------
# Generate with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-change-me
LITELLM_PORT=4000

# Local LLM endpoints (must include /v1)
# Example: https://<gpu-host>:8443/v1
LLAMA_SERVER_URL=
# Portable host (leave empty if not available)
PORTABLE_LLM_SERVER_URL=

# Local model names (must match llama-swap model keys)
# Prefix with "openai/" for LiteLLM's OpenAI-compatible routing
REASONER_LOCAL_MODEL=openai/gpt-oss-20b-MXFP4
JUDGE_LOCAL_MODEL=openai/Qwen2.5-7B-Instruct-Q4_K_M

# Cloud fallback models
REASONER_CLOUD_MODEL=openai/gpt-4o
JUDGE_CLOUD_MODEL=openai/gpt-4o-mini

# Cloud API key (optional, for fallback)
CLOUD_API_KEY=
